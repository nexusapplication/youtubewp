<Page

    x:Class="App1.VideoPage"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:local="using:App1"

    xmlns:helpers="using:App1.Helpers"
    xmlns:controls="using:App1.Controls"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    mc:Ignorable="d"

    RequestedTheme="Dark"

    Background="{StaticResource YtBg}">

    <Page.Resources>
        <DataTemplate x:Key="RelatedShortsShelfTemplate">
            <StackPanel Margin="0,0,0,12">
                <Grid Margin="12,8,12,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="ms-appx:///youtubeicons/shortsfilled.png" Width="22" Height="22"/>
                        <TextBlock Text="Shorts" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <ItemsControl ItemsSource="{Binding Shorts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="120" Height="210" CornerRadius="12" Background="#1A1A1A" Margin="0,0,8,0" Tapped="ShortShelfItem_Tapped">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail, Converter={StaticResource ThumbImageSmall}}" Stretch="UniformToFill"/>
                                        <Border VerticalAlignment="Bottom" Background="#99000000" Padding="8,6">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11" TextWrapping="Wrap" MaxHeight="40" LineHeight="14"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>
        <helpers:FeedItemTemplateSelector x:Key="RelatedFeedSelector"
            VideoTemplate="{StaticResource FeedVideoCardTemplate}"
            PlaceholderTemplate="{StaticResource FeedPlaceholderTemplate}"
            ShortsShelfTemplate="{StaticResource RelatedShortsShelfTemplate}"
            CommunityPostTemplate="{StaticResource CommunityPostTemplate}"/>
    </Page.Resources>



    <Grid x:Name="PageRoot" Background="{StaticResource YtBg}">
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <Grid x:Name="PlayerHost" Grid.RowSpan="1" Background="Black" Height="211" Canvas.ZIndex="2"
              ManipulationMode="TranslateY,System"
              ManipulationStarted="PlayerHost_ManipulationStarted"
              ManipulationDelta="PlayerHost_ManipulationDelta"
              ManipulationCompleted="PlayerHost_ManipulationCompleted">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PlayerHostScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="PlayerHostTransform"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <MediaElement x:Name="Player"
                          AutoPlay="True"
                          Stretch="Uniform"
                          MediaOpened="Player_MediaOpened"
                          MediaFailed="Player_MediaFailed"
                          MediaEnded="Player_MediaEnded"
                          CurrentStateChanged="Player_CurrentStateChanged"/>

            <Border x:Name="PlayerDimmer" Background="#B3000000" Visibility="Collapsed"/>

            <controls:ShimmerPlaceholder x:Name="PlayerShimmer" ShowSpinner="True" Visibility="Collapsed"/>

            <Image x:Name="PlayGlyph" Source="ms-appx:///youtubeicons/play.png" Width="56" Height="56"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <Grid x:Name="PlayerGesture" Background="Transparent"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Tapped="PlayerHost_Tapped" DoubleTapped="PlayerHost_DoubleTapped"/>

            <TextBlock x:Name="SeekHint" FontSize="22" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <Slider x:Name="PositionSlider" VerticalAlignment="Bottom" Minimum="0" Maximum="1" Height="16"
                    Foreground="{StaticResource YtRed}" Background="#33FFFFFF"
                    ValueChanged="PositionSlider_ValueChanged"/>

            <Grid x:Name="PlayerOverlay" Visibility="Collapsed">
                <Grid VerticalAlignment="Top" Margin="4,6,4,0">
                    <Button Style="{StaticResource IconButton}" Click="Back_Click" HorizontalAlignment="Left">
                        <Image Source="ms-appx:///youtubeicons/minimizevideo.png" Width="22" Height="22"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Click="Captions_Click">
                            <Image x:Name="CaptionsIcon" Source="ms-appx:///youtubeicons/closedcaptionshollow.png" Width="22" Height="22"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Settings_Click">
                            <Image Source="ms-appx:///youtubeicons/settingsicon.png" Width="22" Height="22"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#66000000" CornerRadius="28" Width="52" Height="52" Margin="8" Tapped="PrevVideo_Tapped">
                        <Image Source="ms-appx:///youtubeicons/lastvideo.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="#88000000" CornerRadius="36" Width="68" Height="68" Margin="8" Tapped="OverlayPlayPause_Tapped">
                        <Image x:Name="OverlayPlayIcon" Source="ms-appx:///youtubeicons/play.png" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="#66000000" CornerRadius="28" Width="52" Height="52" Margin="8" Tapped="NextVideo_Tapped">
                        <Image Source="ms-appx:///youtubeicons/nextvideo.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <Grid VerticalAlignment="Bottom" Margin="0,0,0,18">
                    <Border Background="#66000000" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TimeText" Text="0:00 / 0:00" Foreground="White" FontSize="12"/>
                    </Border>
                    <StackPanel x:Name="FullscreenActions" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Style="{StaticResource WatchActionPill}" Margin="0,0,8,0" Tapped="Like_Tapped">
                            <Image x:Name="OverlayLikeIcon" Source="ms-appx:///youtubeicons/likehollow.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource WatchActionPill}" Margin="0,0,8,0" Tapped="Dislike_Tapped">
                            <Image x:Name="OverlayDislikeIcon" Source="ms-appx:///youtubeicons/dislikehollow.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource WatchActionPill}" Margin="0,0,8,0" Tapped="CommentsPreview_Tapped">
                            <Image Source="ms-appx:///youtubeicons/commentshollow.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource WatchActionPill}" Tapped="More_Tapped">
                            <Image Source="ms-appx:///youtubeicons/informationicon.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Click="FullScreen_Click" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image x:Name="FullScreenIcon" Source="ms-appx:///youtubeicons/fullscreen.png" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Grid>

        </Grid>



        <ScrollViewer x:Name="ContentScroll" Grid.Row="1">

            <StackPanel Margin="12,10,12,24">

                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="24"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="MetaText" Foreground="{StaticResource YtSecondary}" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MoreLink" Text=" ...more" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               Tapped="More_Tapped" Visibility="Collapsed"/>
                </StackPanel>

                <Grid Margin="0,14,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40" Margin="0,0,12,0" Tapped="Channel_Tapped">
                        <Ellipse Fill="#22FFFFFF"/>
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush x:Name="AuthorBrush" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
            <Border x:Name="SubscribePill" Grid.Column="1" Style="{StaticResource SubscribePillBorder}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Tapped="Subscribe_Tapped">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="SubscribeBellIcon" Source="ms-appx:///youtubeicons/subscriptionsfilled.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="SubscribeLabel" Text="Subscribe" Foreground="Black" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                    <Border Style="{StaticResource WatchActionPill}" Margin="0,0,8,0" Tapped="Like_Tapped">
                        <Image x:Name="LikeIcon" Source="ms-appx:///youtubeicons/likehollow.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource WatchActionPill}" Margin="0,0,8,0" Tapped="Dislike_Tapped">
                        <Image x:Name="DislikeIcon" Source="ms-appx:///youtubeicons/dislikehollow.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource WatchActionPill}" Margin="0,0,8,0" Tapped="Share_Tapped">
                        <Image Source="ms-appx:///youtubeicons/shareicon.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource WatchActionPill}" Margin="0,0,8,0" Tapped="Save_Tapped">
                        <Image Source="ms-appx:///youtubeicons/savetoplaylist.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource WatchActionPill}" Tapped="More_Tapped">
                        <Image Source="ms-appx:///youtubeicons/informationicon.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="13" Foreground="#FFE6E6E6" Margin="0,10,0,0" Visibility="Collapsed"/>

                <Border x:Name="CommentsPreview" Background="#1A1A1A" CornerRadius="12" Margin="0,16,0,16" Tapped="CommentsPreview_Tapped" Visibility="Visible">
                    <StackPanel Margin="12,12">
                        <TextBlock x:Name="CommentsPreviewHeader" FontSize="15" FontWeight="SemiBold"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="28" Height="28" VerticalAlignment="Top" Margin="0,0,10,0">
                                <Ellipse Fill="#22FFFFFF"/>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="TopCommentBrush" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <TextBlock x:Name="TopCommentText" Grid.Column="1" Foreground="{StaticResource YtSecondary}" FontSize="13" TextWrapping="Wrap" MaxHeight="60" LineHeight="18"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="CommentsExpanded" Visibility="Collapsed">
                    <TextBlock x:Name="CommentsHeader" Text="Comments" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ListView x:Name="CommentsList" ItemTemplate="{StaticResource CommentTemplate}" IsItemClickEnabled="False" SelectionMode="None" Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <TextBlock x:Name="CommentsEmpty" Text="No comments on this video." Foreground="{StaticResource YtSecondary}" Visibility="Collapsed" Margin="0,0,0,16"/>
                </StackPanel>



                <TextBlock Text="Up next" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8"/>

                <ListView x:Name="RelatedList"
                          Padding="0"
                          MaxHeight="480"
                          ItemTemplateSelector="{StaticResource RelatedFeedSelector}"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          ItemClick="RelatedList_ItemClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

            </StackPanel>

        </ScrollViewer>

        <TextBlock x:Name="ErrorText" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"

                   TextWrapping="Wrap" TextAlignment="Center" Margin="24" Foreground="{StaticResource YtSecondary}"/>

        <Grid x:Name="LandscapeSidePanel" Grid.RowSpan="2" Visibility="Collapsed" Background="#111111" HorizontalAlignment="Right" Width="300">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="12,8,4,8">
                <TextBlock x:Name="LandscapePanelTitle" FontSize="16" FontWeight="SemiBold"/>
                <Button Style="{StaticResource IconButton}" Click="LandscapePanelClose_Click" HorizontalAlignment="Right">
                    <TextBlock Text="&#xE10A;" FontFamily="Segoe UI Symbol" FontSize="18"/>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" Margin="12,0,12,12">
                <StackPanel x:Name="LandscapePanelContent"/>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="InfoOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#99000000" Tapped="InfoOverlayBackground_Tapped">
            <Border x:Name="InfoOverlayCard" Background="#1A1A1A" CornerRadius="16" Margin="16,32,16,32" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="16,12,8,8">
                        <TextBlock x:Name="InfoOverlayTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Click="InfoOverlayClose_Click" HorizontalAlignment="Right">
                            <TextBlock Text="&#xE10A;" FontFamily="Segoe UI Symbol" FontSize="18"/>
                        </Button>
                    </Grid>
                    <ScrollViewer x:Name="InfoOverlayScroll" Grid.Row="1" Margin="16,0,16,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="InfoOverlayBodyHost"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>

</Page>

