<Application
    x:Class="App1.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:App1.Converters"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisInvert" Invert="True"/>
            <converters:StringToVisibilityConverter x:Key="StringToVis"/>
            <converters:UrlToImageConverter x:Key="ThumbImage" DecodeWidth="480"/>
            <converters:UrlToImageConverter x:Key="AvatarImage" DecodeWidth="88"/>

            <Style x:Key="HeaderlessPivot" TargetType="Pivot">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Grid Height="0" Width="0" Visibility="Collapsed"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="PivotItem">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <SolidColorBrush x:Key="YtRed" Color="#FFFF0000"/>
            <SolidColorBrush x:Key="YtBg" Color="#FF000000"/>
            <SolidColorBrush x:Key="YtSurface" Color="#FF000000"/>
            <SolidColorBrush x:Key="YtElevated" Color="#FF000000"/>
            <SolidColorBrush x:Key="YtText" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="YtSecondary" Color="#FFAAAAAA"/>
            <SolidColorBrush x:Key="YtMuted" Color="#FF8A8A8A"/>
            <SolidColorBrush x:Key="YtLike" Color="#FF3EA6FF"/>
            <SolidColorBrush x:Key="YtNavOff" Color="#FF8A8A8A"/>

            <Style x:Key="NavLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="Foreground" Value="{StaticResource YtNavOff}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="NavIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="Foreground" Value="{StaticResource YtNavOff}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="MinWidth" Value="40"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <DataTemplate x:Key="VideoCardTemplate">
                <Grid Margin="0,0,0,14" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Background="Black">
                        <Image Source="{Binding Thumbnail, Converter={StaticResource ThumbImage}}" Stretch="UniformToFill" Height="202" HorizontalAlignment="Stretch"/>
                        <Border Background="#CC000000" Padding="5,1" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LengthText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{StaticResource YtRed}" Padding="6,2" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="LIVE" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="12,10,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="36" Height="36" VerticalAlignment="Top" Margin="0,2,12,0">
                            <Ellipse Fill="#22FFFFFF"/>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AuthorThumbnail, Converter={StaticResource AvatarImage}}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" TextWrapping="Wrap" MaxHeight="42" LineHeight="21"/>
                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource YtSecondary}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ShortCardTemplate">
                <Grid Height="{Binding CardHeight}" Margin="0,0,0,8" Background="Black">
                    <Image Source="{Binding Thumbnail, Converter={StaticResource ThumbImage}}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <Border VerticalAlignment="Bottom">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#CC000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="16,48,16,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="SHORTS" Foreground="White" FontSize="12" FontWeight="Bold" Opacity="0.9"/>
                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="52" Margin="0,6,12,0"/>
                                <TextBlock Text="{Binding Author}" Foreground="White" FontSize="14" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding ViewCountText}" Foreground="#DDFFFFFF" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE102;" FontFamily="Segoe UI Symbol" FontSize="28" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Play" Foreground="White" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                                <TextBlock Text="&#xE19F;" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ViewCountText}" Foreground="White" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CommentTemplate">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,10,0">
                        <Ellipse Fill="#22FFFFFF"/>
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AuthorThumbnail, Converter={StaticResource AvatarImage}}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Author}" Foreground="{StaticResource YtSecondary}" FontSize="12"/>
                            <TextBlock Text="{Binding PublishedText}" Foreground="{StaticResource YtMuted}" FontSize="12" Margin="8,0,0,0"/>
                            <Border Background="#22FFFFFF" CornerRadius="2" Padding="4,0" Margin="8,0,0,0" Visibility="{Binding BadgeText, Converter={StaticResource StringToVis}}">
                                <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="10"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Content}" Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="&#xE19F;" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="{StaticResource YtSecondary}"/>
                            <TextBlock Text="{Binding LikeText}" Foreground="{StaticResource YtSecondary}" FontSize="12" Margin="6,0,16,0"/>
                            <TextBlock Text="{Binding ReplyText}" Foreground="{StaticResource YtLike}" FontSize="12" Visibility="{Binding ReplyText, Converter={StaticResource StringToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

