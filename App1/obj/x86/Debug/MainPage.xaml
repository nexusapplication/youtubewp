<Page
    x:Class="App1.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    Background="{StaticResource YtBg}">

    <Grid Background="{StaticResource YtBg}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderBar" Background="Black" Canvas.ZIndex="20">
            <Image Source="ms-appx:///Assets/logobig.png" Height="28" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                <Button x:ConnectionId='24' Style="{StaticResource IconButton}"                            ToolTipService.ToolTip="Search">
                    <TextBlock Text="&#xE11A;" FontFamily="Segoe UI Symbol" FontSize="20"/>
                </Button>
                <Button x:ConnectionId='25' Style="{StaticResource IconButton}"                        ToolTipService.ToolTip="Settings">
                    <TextBlock Text="&#xE13D;" FontFamily="Segoe UI Symbol" FontSize="20"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="SearchBar" Grid.Row="1" Background="{StaticResource YtSurface}" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='22' x:Name="SearchBox" PlaceholderText="Search YouTube" BorderThickness="0" Background="Transparent"
                     Foreground="White" Margin="12,8" InputScope="Search"                            />
            <Button x:ConnectionId='23' Grid.Column="1" Style="{StaticResource IconButton}"                        Margin="0,0,8,0">
                <TextBlock Text="&#xE11A;" FontFamily="Segoe UI Symbol" FontSize="18"/>
            </Button>
        </Grid>

        <Grid x:Name="PivotHost" Grid.Row="2">
            <Pivot x:ConnectionId='5' x:Name="MainPivot" Style="{StaticResource HeaderlessPivot}"                                              >
                <PivotItem Header="Home" Margin="0">
                    <Grid>
                        <ListView x:ConnectionId='21' x:Name="HomeList"
                                  ItemsSource="{Binding HomeVideos}"
                                  ItemTemplate="{StaticResource VideoCardTemplate}"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                                             
>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <ProgressRing x:Name="HomeLoading" Width="48" Height="48" IsActive="False" Foreground="{StaticResource YtRed}"/>
                        <TextBlock x:Name="HomeEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource YtSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                                   Text="Couldn't load the Home feed. Pull the Home tab again or pick another instance in Settings."/>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Shorts" Margin="0">
                    <Grid x:Name="ShortsRoot" Background="Black">
                        <MediaElement x:ConnectionId='10' x:Name="ShortsPlayer"
                                      AutoPlay="True"
                                      Stretch="UniformToFill"
                                      IsMuted="False"
                                                                            
                                                                            
                                                                          
                                                                                            />
                        <Image x:Name="ShortsThumb" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <Grid x:ConnectionId='11' Background="Transparent"
                              ManipulationMode="TranslateY"
                                                                                     
                                                                                 
                                                                                         
                                                           />

                        <TextBlock x:Name="ShortsPlayGlyph" Text="&#xE102;" FontFamily="Segoe UI Symbol" FontSize="56" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" Visibility="Collapsed"/>
                        <ProgressRing x:Name="ShortsLoading" Width="48" Height="48" IsActive="False" Foreground="White"/>
                        <TextBlock x:Name="ShortsEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                                   Text="No Shorts found right now. Swipe Home and back to retry."/>

                        <TextBlock Text="Shorts" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="16,10,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Button x:ConnectionId='12' Style="{StaticResource IconButton}"                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,8,0">
                            <TextBlock Text="&#xE11A;" FontFamily="Segoe UI Symbol" FontSize="20" Foreground="White"/>
                        </Button>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,24">
                            <Grid x:ConnectionId='15' Width="48" Height="48" Margin="0,0,0,16"                              >
                                <Ellipse Fill="#22FFFFFF"/>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="ShortsAuthorBrush" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel x:ConnectionId='16' Margin="0,0,0,16"                           >
                                <TextBlock x:Name="ShortsLikeIcon" Text="&#xE19F;" FontFamily="Segoe UI Symbol" FontSize="28" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ShortsLikeLabel" Text="Like" FontSize="11" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel x:ConnectionId='17' Margin="0,0,0,16"                              >
                                <TextBlock x:Name="ShortsDislikeIcon" Text="&#xE19E;" FontFamily="Segoe UI Symbol" FontSize="28" Foreground="White" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="180"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="ShortsDislikeLabel" Text="Dislike" FontSize="11" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel x:ConnectionId='18' Margin="0,0,0,16"                               >
                                <TextBlock Text="&#xE134;" FontFamily="Segoe UI Symbol" FontSize="28" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ShortsCommentLabel" Text="0" FontSize="11" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel x:ConnectionId='19' Margin="0,0,0,16"                           >
                                <TextBlock x:Name="ShortsMuteIcon" Text="&#xE15D;" FontFamily="Segoe UI Symbol" FontSize="28" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ShortsMuteLabel" Text="Sound" FontSize="11" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel x:ConnectionId='20'                            >
                                <TextBlock Text="&#xE11B;" FontFamily="Segoe UI Symbol" FontSize="26" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Share" FontSize="11" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom" Margin="14,0,72,18">
                            <TextBlock x:Name="ShortsAuthorText" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                            <Button x:ConnectionId='14' x:Name="ShortsSubscribeButton" Content="Subscribe"                              
                                    Background="{StaticResource YtRed}" Foreground="White" BorderThickness="0" Padding="10,4" Margin="0,8,0,8" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="ShortsTitleText" Foreground="White" FontSize="14" TextWrapping="Wrap" MaxHeight="40"/>
                            <TextBlock x:Name="ShortsMetaText" Foreground="#CCFFFFFF" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid x:Name="ShortsCommentsPanel" Background="Black" VerticalAlignment="Bottom" Height="320" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock x:Name="ShortsCommentsHeader" Text="Comments" FontSize="16" FontWeight="SemiBold" Margin="16,12"/>
                                <Button x:ConnectionId='13' Style="{StaticResource IconButton}"                                   HorizontalAlignment="Right" Margin="0,4,4,0">
                                    <TextBlock Text="&#xE10A;" FontFamily="Segoe UI Symbol" FontSize="18"/>
                                </Button>
                            </Grid>
                            <ListView Grid.Row="1" x:Name="ShortsCommentsList" ItemTemplate="{StaticResource CommentTemplate}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="12,0,12,0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Subs" Margin="0">
                    <Grid>
                        <ListView x:ConnectionId='9' x:Name="SubsList"
                                  ItemsSource="{Binding SubscriptionVideos}"
                                  ItemTemplate="{StaticResource VideoCardTemplate}"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                                             
>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <ProgressRing x:Name="SubsLoading" Width="48" Height="48" IsActive="False" Foreground="{StaticResource YtRed}"/>
                        <TextBlock x:Name="SubsEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource YtSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                                   Text="Subscribe to channels from a video page to fill this tab. Shorts from those channels appear in Shorts."/>
                    </Grid>
                </PivotItem>

                <PivotItem Header="You" Margin="0">
                    <ListView x:ConnectionId='7' x:Name="HistoryList"
                              ItemsSource="{Binding HistoryVideos}"
                              ItemTemplate="{StaticResource VideoCardTemplate}"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                                                         >
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Header>
                            <StackPanel>
                                <Grid x:ConnectionId='8' Background="{StaticResource YtSurface}" Margin="12,8"                         >
                                    <TextBlock Text="Settings" Margin="16" FontSize="16"/>
                                    <TextBlock Text="&#xE111;" FontFamily="Segoe UI Symbol" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16" Foreground="{StaticResource YtSecondary}"/>
                                </Grid>
                                <TextBlock x:Name="InstanceLabel" Foreground="{StaticResource YtMuted}" FontSize="12" Margin="16,4,16,8" TextWrapping="Wrap"/>
                                <TextBlock Text="History" FontSize="18" FontWeight="SemiBold" Margin="12,8,12,8"/>
                                <TextBlock x:Name="HistoryEmpty" Text="Videos you watch will show up here." Foreground="{StaticResource YtSecondary}" Margin="12,0,12,16" Visibility="Collapsed"/>
                            </StackPanel>
                        </ListView.Header>
                    </ListView>
                </PivotItem>
            </Pivot>

            <Grid x:Name="SearchOverlay" Background="{StaticResource YtBg}" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Search results" FontSize="16" FontWeight="SemiBold" Margin="12,8"/>
                <ListView x:ConnectionId='6' Grid.Row="1"
                          x:Name="SearchList"
                          ItemsSource="{Binding SearchVideos}"
                          ItemTemplate="{StaticResource VideoCardTemplate}"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                                                     >
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <ProgressRing x:Name="SearchLoading" Grid.Row="1" Width="48" Height="48" IsActive="False" Foreground="{StaticResource YtRed}"/>
                <TextBlock x:Name="SearchEmpty" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource YtSecondary}" Text="No videos matched that search."/>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="Black" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:ConnectionId='1' x:Name="NavHome"                         VerticalAlignment="Center">
                    <TextBlock x:Name="NavHomeIcon" Style="{StaticResource NavIcon}" Text="&#xE10F;" Foreground="White"/>
                    <TextBlock x:Name="NavHomeLabel" Style="{StaticResource NavLabel}" Text="Home" Foreground="White"/>
                </StackPanel>
                <StackPanel x:ConnectionId='2' x:Name="NavShorts" Grid.Column="1"                           VerticalAlignment="Center">
                    <TextBlock x:Name="NavShortsIcon" Style="{StaticResource NavIcon}" Text="&#xE173;"/>
                    <TextBlock x:Name="NavShortsLabel" Style="{StaticResource NavLabel}" Text="Shorts"/>
                </StackPanel>
                <StackPanel x:ConnectionId='3' x:Name="NavSubs" Grid.Column="2"                         VerticalAlignment="Center">
                    <TextBlock x:Name="NavSubsIcon" Style="{StaticResource NavIcon}" Text="&#xE125;"/>
                    <TextBlock x:Name="NavSubsLabel" Style="{StaticResource NavLabel}" Text="Subscriptions"/>
                </StackPanel>
                <StackPanel x:ConnectionId='4' x:Name="NavYou" Grid.Column="3"                        VerticalAlignment="Center">
                    <TextBlock x:Name="NavYouIcon" Style="{StaticResource NavIcon}" Text="&#xE13D;"/>
                    <TextBlock x:Name="NavYouLabel" Style="{StaticResource NavLabel}" Text="You"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

