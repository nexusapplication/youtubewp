<Page
    x:Class="App1.ChannelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    Background="{StaticResource YtBg}">

    <Grid Background="{StaticResource YtBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="MiniPlayerRow" Height="0"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="ChannelHeaderPanel">
            <Grid Height="120" Background="#111111">
                <Image x:Name="BannerImage" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Border Background="#33000000"/>
                <Grid Margin="8,8,8,0" VerticalAlignment="Top">
                    <Button x:ConnectionId='24' Style="{StaticResource IconButton}"                    HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="&#xE0E2;" FontFamily="Segoe UI Symbol" FontSize="20" Foreground="White"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:ConnectionId='25' Style="{StaticResource IconButton}"                     >
                            <Image Source="ms-appx:///youtubeicons/searchicon.png" Width="20" Height="20"/>
                        </Button>
                        <Button x:ConnectionId='26' Style="{StaticResource IconButton}"                   >
                            <Image Source="ms-appx:///youtubeicons/settingsicon.png" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Margin="16,-36,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="80" Height="80" CornerRadius="40" VerticalAlignment="Top">
                    <Border.Background>
                        <ImageBrush x:Name="AuthorBrush" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,44,0,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AuthorText" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                        <Image x:ConnectionId='23' Source="ms-appx:///youtubeicons/informationicon.png" Width="20" Height="20" Margin="6,2,0,0" VerticalAlignment="Top" Opacity="0.85"                            />
                    </StackPanel>
                    <TextBlock x:Name="HandleText" Foreground="{StaticResource YtSecondary}" FontSize="13" Margin="0,2,0,0"/>
                    <TextBlock x:Name="MetaText" Foreground="{StaticResource YtSecondary}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <StackPanel Margin="16,12,16,0">
                <TextBlock x:Name="DescriptionText" Foreground="White" FontSize="13" TextWrapping="Wrap" MaxHeight="52"/>
                <TextBlock x:ConnectionId='22' x:Name="DescriptionMore" Text="...more" Foreground="White" FontWeight="SemiBold" FontSize="13"                                 Visibility="Collapsed"/>
                <TextBlock x:Name="LinksText" Foreground="#8AB4F8" FontSize="13" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <Grid Margin="16,14,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:ConnectionId='20' x:Name="SubscribeButton" Grid.Column="0" Style="{StaticResource SubscribePillButton}" Margin="0,0,6,0"                        
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="SubscribeBellIcon" Source="ms-appx:///youtubeicons/subscriptionsfilled.png" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="SubscribeLabel" Text="Subscribe"/>
                    </StackPanel>
                </Button>
                <Button x:ConnectionId='21' x:Name="JoinButton" Grid.Column="1" Margin="6,0,0,0"                   
                        Background="#272727" Foreground="White" BorderThickness="0" Padding="12,10" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" FontWeight="SemiBold" FontSize="13" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="ms-appx:///youtubeicons/likefilled.png" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Join"/>
                    </StackPanel>
                </Button>
            </Grid>
            </StackPanel>

            <ScrollViewer x:ConnectionId='11' x:Name="ChannelContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"                                               >
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:ConnectionId='16' x:Name="TabHome" Grid.Column="0" Style="{StaticResource TouchNavStack}"                        >
                            <TextBlock x:Name="TabHomeLabel" Text="Home" HorizontalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                            <Border x:Name="TabHomeUnderline" Height="3" Background="White" Margin="12,8,12,0" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel x:ConnectionId='17' x:Name="TabVideos" Grid.Column="1" Style="{StaticResource TouchNavStack}"                          >
                            <TextBlock x:Name="TabVideosLabel" Text="Videos" HorizontalAlignment="Center" Foreground="{StaticResource YtNavOff}"/>
                            <Border x:Name="TabVideosUnderline" Height="3" Background="White" Margin="12,8,12,0" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel x:ConnectionId='18' x:Name="TabShorts" Grid.Column="2" Style="{StaticResource TouchNavStack}"                          >
                            <TextBlock x:Name="TabShortsLabel" Text="Shorts" HorizontalAlignment="Center" Foreground="{StaticResource YtNavOff}"/>
                            <Border x:Name="TabShortsUnderline" Height="3" Background="White" Margin="12,8,12,0" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel x:ConnectionId='19' x:Name="TabPosts" Grid.Column="3" Style="{StaticResource TouchNavStack}"                         >
                            <TextBlock x:Name="TabPostsLabel" Text="Posts" HorizontalAlignment="Center" Foreground="{StaticResource YtNavOff}"/>
                            <Border x:Name="TabPostsUnderline" Height="3" Background="White" Margin="12,8,12,0" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="HomeTabContent">
                        <TextBlock Text="For you" FontSize="16" FontWeight="SemiBold" Margin="16,8,16,10"/>
                        <ListView x:ConnectionId='14' x:Name="ForYouList"
                                  Height="170"
                                  Padding="16,0,0,0"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                                             
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChannelCarouselVideoTemplate}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid Margin="16,16,16,8" Visibility="Collapsed" x:Name="FeaturedHeaderRow">
                            <TextBlock Text="Featured channels" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="&#xE0E3;" FontFamily="Segoe UI Symbol" HorizontalAlignment="Right" Foreground="White"/>
                        </Grid>
                        <ListView x:ConnectionId='15' x:Name="FeaturedList"
                                  Height="88"
                                  Padding="16,0,0,8"
                                  Visibility="Collapsed"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                                                
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="72" Margin="0,0,12,0">
                                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                            <Ellipse Fill="#22FFFFFF"/>
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AuthorThumbnail, Converter={StaticResource AvatarImage}}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock Text="{Binding Author}" Foreground="White" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel x:Name="VideosTabContent" Visibility="Collapsed">
                        <ListView x:ConnectionId='13' x:Name="VideosList"
                                  Padding="0"
                                  ItemTemplate="{StaticResource ChannelCompactVideoTemplate}"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                                             >
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>

                    <StackPanel x:Name="ShortsTabContent" Visibility="Collapsed" Margin="0,8,0,0">
                        <ListView x:ConnectionId='12' x:Name="ShortsList"
                                  Height="220"
                                  Padding="16,0,0,0"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                                             
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChannelShortCarouselTemplate}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel x:Name="PostsTabContent" Visibility="Collapsed" Margin="0,8,0,0">
                        <ListView x:Name="PostsList"
                                  Padding="12,0"
                                  IsItemClickEnabled="False"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CommunityPostTemplate}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="PostsEmpty" Text="No community posts yet." Foreground="{StaticResource YtSecondary}" Margin="16" Visibility="Collapsed"/>
                        <ProgressRing x:Name="PostsLoading" Width="32" Height="32" IsActive="False" Foreground="{StaticResource YtRed}" HorizontalAlignment="Center" Margin="16"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="MiniPlayerBar" Grid.Row="1" Visibility="Collapsed" Background="#212121"
                BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0">
            <Grid Height="56" Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid x:ConnectionId='7' Width="64" Height="36" Margin="0,0,10,0" Background="Black"                                 >
                    <MediaElement x:Name="MiniPlayer" Stretch="UniformToFill" IsMuted="False"/>
                    <Image x:Name="MiniPlayerThumb" Stretch="UniformToFill"/>
                </Grid>
                <StackPanel x:ConnectionId='8' Grid.Column="1" VerticalAlignment="Center"                                 >
                    <TextBlock x:Name="MiniPlayerTitle" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MiniPlayerAuthor" Foreground="#AAAAAA" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:ConnectionId='9' Grid.Column="2" Style="{StaticResource IconButton}"                                   MinWidth="36" MinHeight="36" Padding="6">
                    <Image x:Name="MiniPlayerPlayIcon" Source="ms-appx:///youtubeicons/pause.png" Width="20" Height="20"/>
                </Button>
                <Button x:ConnectionId='10' Grid.Column="3" Style="{StaticResource IconButton}"                               MinWidth="36" MinHeight="36" Padding="6">
                    <Image Source="ms-appx:///youtubeicons/minimizevideo.png" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="Black" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:ConnectionId='3'                         VerticalAlignment="Center">
                    <Image x:Name="NavHomeIcon" Style="{StaticResource NavIconImage}" Source="ms-appx:///youtubeicons/homehollow.png"/>
                    <TextBlock x:Name="NavHomeLabel" Style="{StaticResource NavLabel}" Text="Home"/>
                </StackPanel>
                <StackPanel x:ConnectionId='4' Grid.Column="1"                           VerticalAlignment="Center">
                    <Image x:Name="NavShortsIcon" Style="{StaticResource NavIconImage}" Source="ms-appx:///youtubeicons/shortshollow.png"/>
                    <TextBlock x:Name="NavShortsLabel" Style="{StaticResource NavLabel}" Text="Shorts"/>
                </StackPanel>
                <StackPanel x:ConnectionId='5' Grid.Column="2"                         VerticalAlignment="Center">
                    <Image x:Name="NavSubsIcon" Style="{StaticResource NavIconImage}" Source="ms-appx:///youtubeicons/subscriptionshollow.png"/>
                    <TextBlock x:Name="NavSubsLabel" Style="{StaticResource NavLabel}" Text="Subscriptions"/>
                </StackPanel>
                <StackPanel x:ConnectionId='6' Grid.Column="3"                        VerticalAlignment="Center">
                    <Image x:Name="NavYouIcon" Style="{StaticResource NavIconImage}" Source="ms-appx:///youtubeicons/libraryhollow.png"/>
                    <TextBlock x:Name="NavYouLabel" Style="{StaticResource NavLabel}" Text="You"/>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressRing x:Name="PageLoading" Width="48" Height="48" IsActive="False" Foreground="{StaticResource YtRed}" Grid.Row="0"/>
        <TextBlock x:Name="ErrorText" Grid.Row="0" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" Margin="24" Foreground="{StaticResource YtSecondary}"/>

        <Grid x:ConnectionId='1' x:Name="InfoOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#99000000"                                      >
            <Border Background="#1A1A1A" CornerRadius="16" Margin="16,48,16,88" VerticalAlignment="Center" MaxHeight="520">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="16,12,8,8">
                        <TextBlock x:Name="InfoOverlayTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:ConnectionId='2' Style="{StaticResource IconButton}"                                HorizontalAlignment="Right">
                            <TextBlock Text="&#xE10A;" FontFamily="Segoe UI Symbol" FontSize="18"/>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="16,0,16,16">
                        <TextBlock x:Name="InfoOverlayBody" TextWrapping="Wrap" FontSize="14" Foreground="White"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

