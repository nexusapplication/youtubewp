<Page
    x:Class="App1.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1"
    xmlns:helpers="using:App1.Helpers"
    xmlns:controls="using:App1.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    Background="{StaticResource YtBg}">

    <Page.Resources>
        <DataTemplate x:Key="MainShortsShelfTemplate">
            <StackPanel Margin="0,0,0,12">
                <Grid Margin="12,8,12,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="ms-appx:///youtubeicons/shortsfilled.png" Width="22" Height="22"/>
                        <TextBlock Text="Shorts" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{Binding Shorts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:ConnectionId='1' Width="120" Height="210" CornerRadius="12" Background="#1A1A1A" Margin="0,0,8,0"                               >
                                    <Grid>
                                        <Image Source="{Binding Thumbnail, Converter={StaticResource ThumbImageSmall}}" Stretch="UniformToFill"/>
                                        <Border VerticalAlignment="Bottom" Background="#99000000" Padding="8,6">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11" TextWrapping="Wrap" MaxHeight="40" LineHeight="14"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>
        <helpers:FeedItemTemplateSelector x:Key="MainFeedSelector"
            VideoTemplate="{StaticResource FeedVideoCardTemplate}"
            PlaceholderTemplate="{StaticResource FeedPlaceholderTemplate}"
            ShortsShelfTemplate="{StaticResource MainShortsShelfTemplate}"
            CommunityPostTemplate="{StaticResource CommunityPostTemplate}"/>
    </Page.Resources>

    <Grid Background="{StaticResource YtBg}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="MiniPlayerRow" Height="0"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderBar" Grid.Row="0" Background="Black" Height="48" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="ms-appx:///Assets/logobig.png" Height="24" MaxWidth="130" Stretch="Uniform"
                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,8,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <Button x:ConnectionId='31' Style="{StaticResource IconButton}"                            ToolTipService.ToolTip="Search" MinWidth="48" MinHeight="48" Padding="8">
                    <Image Source="ms-appx:///youtubeicons/searchicon.png" Width="22" Height="22"/>
                </Button>
                <Button x:ConnectionId='32' Style="{StaticResource IconButton}"                        ToolTipService.ToolTip="Settings" MinWidth="48" MinHeight="48" Padding="8">
                    <Image Source="ms-appx:///youtubeicons/settingsicon.png" Width="22" Height="22"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="SearchBar" Grid.Row="1" Background="{StaticResource YtSurface}" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='29' x:Name="SearchBox" PlaceholderText="Search YouTube" BorderThickness="0" Background="Transparent"
                     Foreground="White" Margin="12,8" InputScope="Search"                            />
            <Button x:ConnectionId='30' Grid.Column="1" Style="{StaticResource IconButton}"                        Margin="0,0,8,0">
                <Image Source="ms-appx:///youtubeicons/searchicon.png" Width="20" Height="20"/>
            </Button>
        </Grid>

        <Grid x:Name="PivotHost" Grid.Row="2">
            <Pivot x:ConnectionId='11' x:Name="MainPivot" Style="{StaticResource HeaderlessPivot}"                                              >
                <PivotItem Header="Home" Margin="0">
                    <Grid>
                        <ListView x:ConnectionId='28' x:Name="HomeList"
                                  Padding="0"
                                  ItemsSource="{Binding HomeFeed}"
                                  ItemTemplateSelector="{StaticResource MainFeedSelector}"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                                            
                                                          >
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <TextBlock x:Name="HomeEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource YtSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                                   Text="Couldn't load the Home feed. Pull the Home tab again or pick another instance in Settings."/>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Shorts" Margin="0">
                    <Grid x:Name="ShortsRoot" Background="Black">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ShortsSlideTransform"/>
                        </Grid.RenderTransform>
                        <MediaElement x:ConnectionId='17' x:Name="ShortsPlayer"
                                      AutoPlay="True"
                                      Stretch="UniformToFill"
                                      IsMuted="False"
                                                                            
                                                                            
                                                                          
                                                                                            />
                        <Image x:Name="ShortsThumb" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <controls:ShimmerPlaceholder x:Name="ShortsShimmer" ShowSpinner="True" Visibility="Collapsed"/>

                        <Grid x:ConnectionId='18' Background="Transparent"
                              ManipulationMode="TranslateY"
                                                                                     
                                                                                 
                                                                                         
                                                           
                                                                       />

                        <Image x:Name="ShortsPlayGlyph" Source="ms-appx:///youtubeicons/play.png" Width="56" Height="56"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="ShortsEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                                   Text="No Shorts found right now. Swipe Home and back to retry."/>

                        <Border VerticalAlignment="Top" Height="88" IsHitTestVisible="False" HorizontalAlignment="Stretch">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#99000000" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border VerticalAlignment="Bottom" Height="240" IsHitTestVisible="False" HorizontalAlignment="Stretch">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#66000000" Offset="0.45"/>
                                    <GradientStop Color="#CC000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,12,0,0">
                            <TextBlock Text="Shorts" Style="{StaticResource ShortsOverlayTitleShadow}" FontSize="18"/>
                            <TextBlock Text="Shorts" Style="{StaticResource ShortsOverlayTitle}" FontSize="18"/>
                        </Grid>
                        <Border Background="#66000000" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0">
                            <Button x:ConnectionId='27' Style="{StaticResource IconButton}"                            MinWidth="40" MinHeight="40" Padding="0">
                                <Image Source="ms-appx:///youtubeicons/searchicon.png" Width="20" Height="20"/>
                            </Button>
                        </Border>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,24">
                            <Grid x:ConnectionId='21' Width="48" Height="48" Margin="0,0,0,14"                              >
                                <Ellipse Fill="#66000000" Margin="0,2,0,-2"/>
                                <Ellipse Fill="#22FFFFFF"/>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="ShortsAuthorBrush" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel x:ConnectionId='22' Margin="0,0,0,14"                           >
                                <Grid Width="32" Height="32" HorizontalAlignment="Center">
                                    <Image Source="ms-appx:///youtubeicons/likehollow.png" Width="28" Height="28" Opacity="0.45" Margin="0,1,0,-1"/>
                                    <Image x:Name="ShortsLikeIcon" Source="ms-appx:///youtubeicons/likehollow.png" Width="28" Height="28"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="ShortsLikeLabelShadow" Text="Like" Style="{StaticResource ShortsOverlayLabelShadow}"/>
                                    <TextBlock x:Name="ShortsLikeLabel" Text="Like" Style="{StaticResource ShortsOverlayLabel}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel x:ConnectionId='23' Margin="0,0,0,14"                              >
                                <Grid Width="32" Height="32" HorizontalAlignment="Center">
                                    <Image Source="ms-appx:///youtubeicons/dislikehollow.png" Width="28" Height="28" Opacity="0.45" Margin="0,1,0,-1"/>
                                    <Image x:Name="ShortsDislikeIcon" Source="ms-appx:///youtubeicons/dislikehollow.png" Width="28" Height="28"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="ShortsDislikeLabelShadow" Text="Dislike" Style="{StaticResource ShortsOverlayLabelShadow}"/>
                                    <TextBlock x:Name="ShortsDislikeLabel" Text="Dislike" Style="{StaticResource ShortsOverlayLabel}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel x:ConnectionId='24' Margin="0,0,0,14"                               >
                                <Grid Width="32" Height="32" HorizontalAlignment="Center">
                                    <Image Source="ms-appx:///youtubeicons/commentshollow.png" Width="28" Height="28" Opacity="0.45" Margin="0,1,0,-1"/>
                                    <Image Source="ms-appx:///youtubeicons/commentshollow.png" Width="28" Height="28"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="ShortsCommentLabelShadow" Text="0" Style="{StaticResource ShortsOverlayLabelShadow}"/>
                                    <TextBlock x:Name="ShortsCommentLabel" Text="0" Style="{StaticResource ShortsOverlayLabel}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel x:ConnectionId='25' Margin="0,0,0,14"                           >
                                <Grid Width="32" Height="32" HorizontalAlignment="Center">
                                    <Image Source="ms-appx:///youtubeicons/closedcaptionshollow.png" Width="28" Height="28" Opacity="0.45" Margin="0,1,0,-1"/>
                                    <Image x:Name="ShortsMuteIcon" Source="ms-appx:///youtubeicons/closedcaptionshollow.png" Width="28" Height="28"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="ShortsMuteLabelShadow" Text="Sound" Style="{StaticResource ShortsOverlayLabelShadow}"/>
                                    <TextBlock x:Name="ShortsMuteLabel" Text="Sound" Style="{StaticResource ShortsOverlayLabel}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel x:ConnectionId='26'                            >
                                <Grid Width="32" Height="32" HorizontalAlignment="Center">
                                    <Image Source="ms-appx:///youtubeicons/shareicon.png" Width="26" Height="26" Opacity="0.45" Margin="0,1,0,-1"/>
                                    <Image Source="ms-appx:///youtubeicons/shareicon.png" Width="26" Height="26"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="Share" Style="{StaticResource ShortsOverlayLabelShadow}"/>
                                    <TextBlock Text="Share" Style="{StaticResource ShortsOverlayLabel}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom" Margin="14,0,72,18">
                            <Grid>
                                <TextBlock x:Name="ShortsAuthorShadow" Style="{StaticResource ShortsOverlayTitleShadow}" FontSize="15"/>
                                <TextBlock x:Name="ShortsAuthorText" Style="{StaticResource ShortsOverlayTitle}" FontSize="15"/>
                            </Grid>
                            <Button x:ConnectionId='20' x:Name="ShortsSubscribeButton" Style="{StaticResource ShortsSubscribePill}"                              
                                    Content="Subscribe" Margin="0,6,0,6"/>
                            <Grid Margin="0,0,0,4">
                                <TextBlock x:Name="ShortsTitleShadow" Style="{StaticResource ShortsOverlayTitleShadow}" FontSize="14" TextWrapping="Wrap" MaxHeight="40"/>
                                <TextBlock x:Name="ShortsTitleText" Style="{StaticResource ShortsOverlayTitle}" FontSize="14" TextWrapping="Wrap" MaxHeight="40"/>
                            </Grid>
                            <Grid>
                                <TextBlock x:Name="ShortsMetaShadow" Foreground="#66000000" FontSize="12" Margin="0,1,0,-1"/>
                                <TextBlock x:Name="ShortsMetaText" Foreground="#EEFFFFFF" FontSize="12"/>
                            </Grid>
                        </StackPanel>

                        <Grid x:Name="ShortsCommentsPanel" Background="Black" VerticalAlignment="Bottom" Height="320" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock x:Name="ShortsCommentsHeader" Text="Comments" FontSize="16" FontWeight="SemiBold" Margin="16,12"/>
                                <Button x:ConnectionId='19' Style="{StaticResource IconButton}"                                   HorizontalAlignment="Right" Margin="0,4,4,0">
                                    <Image Source="ms-appx:///youtubeicons/minimizevideo.png" Width="20" Height="20"/>
                                </Button>
                            </Grid>
                            <ListView Grid.Row="1" x:Name="ShortsCommentsList" ItemTemplate="{StaticResource CommentTemplate}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="12,0,12,0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                            <ProgressRing x:Name="ShortsCommentsLoading" Grid.Row="1" Width="40" Height="40" IsActive="False" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ShortsCommentsEmpty" Grid.Row="1" Text="No comments yet." Foreground="{StaticResource YtSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Subs" Margin="0">
                    <Grid>
                        <ListView x:ConnectionId='16' x:Name="SubsList"
                                  Padding="0"
                                  ItemsSource="{Binding SubscriptionVideos}"
                                  ItemTemplate="{StaticResource VideoCardTemplate}"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                                             
>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <ProgressRing x:Name="SubsLoading" Width="48" Height="48" IsActive="False" Foreground="{StaticResource YtRed}"/>
                        <TextBlock x:Name="SubsEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource YtSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                                   Text="Subscribe to channels from a video page to fill this tab. Shorts from those channels appear in Shorts."/>
                    </Grid>
                </PivotItem>

                <PivotItem Header="You" Margin="0">
                    <ListView x:ConnectionId='13' x:Name="HistoryList"
                              Padding="0"
                              ItemsSource="{Binding HistoryVideos}"
                              ItemTemplate="{StaticResource VideoCardTemplate}"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                                                         >
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Top"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Header>
                            <StackPanel>
                                <Grid x:ConnectionId='14' Background="{StaticResource YtSurface}" Margin="12,8"                         >
                                    <TextBlock Text="Settings" Margin="16" FontSize="16"/>
                                    <Image Source="ms-appx:///youtubeicons/settingsicon.png" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16"/>
                                </Grid>
                                <TextBlock x:Name="InstanceLabel" Foreground="{StaticResource YtMuted}" FontSize="12" Margin="16,4,16,8" TextWrapping="Wrap"/>
                                <TextBlock Text="Playlists" FontSize="18" FontWeight="SemiBold" Margin="12,8,12,8"/>
                                <TextBlock x:Name="PlaylistsEmpty" Text="Sign in with Google in Settings to see playlists." Foreground="{StaticResource YtSecondary}" Margin="12,0,12,8" Visibility="Collapsed"/>
                                <ListView x:ConnectionId='15' x:Name="PlaylistsList" MaxHeight="220" IsItemClickEnabled="True" SelectionMode="None"                                Margin="0,0,0,8">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Thumbnail, Converter={StaticResource ThumbImage}}" Width="72" Height="48" Stretch="UniformToFill"/>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ItemCountText}" Foreground="{StaticResource YtSecondary}" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="History" FontSize="18" FontWeight="SemiBold" Margin="12,8,12,8"/>
                                <TextBlock x:Name="HistoryEmpty" Text="Videos you watch will show up here." Foreground="{StaticResource YtSecondary}" Margin="12,0,12,16" Visibility="Collapsed"/>
                            </StackPanel>
                        </ListView.Header>
                    </ListView>
                </PivotItem>
            </Pivot>

            <Grid x:Name="SearchOverlay" Background="{StaticResource YtBg}" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Search results" FontSize="16" FontWeight="SemiBold" Margin="12,8"/>
                <ListView x:ConnectionId='12' Grid.Row="1"
                          Padding="0"
                          x:Name="SearchList"
                          ItemsSource="{Binding SearchVideos}"
                          ItemTemplate="{StaticResource VideoCardTemplate}"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                                                     >
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <ProgressRing x:Name="SearchLoading" Grid.Row="1" Width="48" Height="48" IsActive="False" Foreground="{StaticResource YtRed}"/>
                <TextBlock x:Name="SearchEmpty" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource YtSecondary}" Text="No videos matched that search."/>
            </Grid>
        </Grid>

        <Border x:Name="MiniPlayerBar" Grid.Row="3" Visibility="Collapsed" Background="#212121"
                BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0">
            <Grid Height="56" Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid x:ConnectionId='6' Width="64" Height="36" Margin="0,0,10,0" Background="Black"                                 >
                    <MediaElement x:ConnectionId='10' x:Name="MiniPlayer" Stretch="UniformToFill" IsMuted="False"
                                                                      />
                    <Image x:Name="MiniPlayerThumb" Stretch="UniformToFill"/>
                </Grid>
                <StackPanel x:ConnectionId='7' Grid.Column="1" VerticalAlignment="Center"                                 >
                    <TextBlock x:Name="MiniPlayerTitle" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MiniPlayerAuthor" Foreground="#AAAAAA" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:ConnectionId='8' Grid.Column="2" Style="{StaticResource IconButton}"                                   MinWidth="36" MinHeight="36" Padding="6">
                    <Image x:Name="MiniPlayerPlayIcon" Source="ms-appx:///youtubeicons/pause.png" Width="20" Height="20"/>
                </Button>
                <Button x:ConnectionId='9' Grid.Column="3" Style="{StaticResource IconButton}"                               MinWidth="36" MinHeight="36" Padding="6">
                    <Image Source="ms-appx:///youtubeicons/minimizevideo.png" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="Black" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:ConnectionId='2' x:Name="NavHome"                         VerticalAlignment="Center">
                    <Image x:Name="NavHomeIcon" Style="{StaticResource NavIconImage}" Source="ms-appx:///youtubeicons/homefilled.png"/>
                    <TextBlock x:Name="NavHomeLabel" Style="{StaticResource NavLabel}" Text="Home" Foreground="White"/>
                </StackPanel>
                <StackPanel x:ConnectionId='3' x:Name="NavShorts" Grid.Column="1"                           VerticalAlignment="Center">
                    <Image x:Name="NavShortsIcon" Style="{StaticResource NavIconImage}" Source="ms-appx:///youtubeicons/shortshollow.png"/>
                    <TextBlock x:Name="NavShortsLabel" Style="{StaticResource NavLabel}" Text="Shorts"/>
                </StackPanel>
                <StackPanel x:ConnectionId='4' x:Name="NavSubs" Grid.Column="2"                         VerticalAlignment="Center">
                    <Image x:Name="NavSubsIcon" Style="{StaticResource NavIconImage}" Source="ms-appx:///youtubeicons/subscriptionshollow.png"/>
                    <TextBlock x:Name="NavSubsLabel" Style="{StaticResource NavLabel}" Text="Subscriptions"/>
                </StackPanel>
                <StackPanel x:ConnectionId='5' x:Name="NavYou" Grid.Column="3"                        VerticalAlignment="Center">
                    <Image x:Name="NavYouIcon" Style="{StaticResource NavIconImage}" Source="ms-appx:///youtubeicons/libraryhollow.png"/>
                    <TextBlock x:Name="NavYouLabel" Style="{StaticResource NavLabel}" Text="You"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

