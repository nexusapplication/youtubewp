<Application
    x:Class="App1.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:App1.Converters"
    xmlns:helpers="using:App1.Helpers"
    xmlns:controls="using:App1.Controls"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisInvert" Invert="True"/>
            <converters:StringToVisibilityConverter x:Key="StringToVis"/>
            <converters:UrlToImageConverter x:Key="ThumbImage" DecodeWidth="360"/>
            <converters:UrlToImageConverter x:Key="ThumbImageSmall" DecodeWidth="120"/>
            <converters:UrlToImageConverter x:Key="AvatarImage" DecodeWidth="72"/>
            <converters:WidthToHeightConverter x:Key="ThumbHeight916" Factor="0.5625" Fallback="270"/>

            <FontFamily x:Key="Roboto">ms-appx:///robotos/Roboto-Regular.ttf#Roboto</FontFamily>
            <FontFamily x:Key="RobotoLight">ms-appx:///robotos/Roboto-Light.ttf#Roboto</FontFamily>
            <FontFamily x:Key="RobotoMedium">ms-appx:///robotos/Roboto-Medium.ttf#Roboto</FontFamily>
            <FontFamily x:Key="RobotoSemiBold">ms-appx:///robotos/Roboto-SemiBold.ttf#Roboto</FontFamily>
            <FontFamily x:Key="RobotoBold">ms-appx:///robotos/Roboto-Bold.ttf#Roboto</FontFamily>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Roboto}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource Roboto}"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource Roboto}"/>
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="FontFamily" Value="{StaticResource Roboto}"/>
            </Style>

            <Style x:Key="HeaderlessPivot" TargetType="Pivot">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Grid Height="0" Width="0" Visibility="Collapsed"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="PivotItem">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <SolidColorBrush x:Key="YtRed" Color="#FFFF0000"/>
            <SolidColorBrush x:Key="YtBg" Color="#FF000000"/>
            <SolidColorBrush x:Key="YtSurface" Color="#FF000000"/>
            <SolidColorBrush x:Key="YtElevated" Color="#FF000000"/>
            <SolidColorBrush x:Key="YtText" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="YtSecondary" Color="#FFAAAAAA"/>
            <SolidColorBrush x:Key="YtMuted" Color="#FF8A8A8A"/>
            <SolidColorBrush x:Key="YtLike" Color="#FF3EA6FF"/>
            <SolidColorBrush x:Key="YtNavOff" Color="#FF8A8A8A"/>

            <Style x:Key="NavLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontFamily" Value="{StaticResource Roboto}"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="Foreground" Value="{StaticResource YtNavOff}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="NavIconImage" TargetType="Image">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="MinWidth" Value="48"/>
                <Setter Property="MinHeight" Value="48"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <Style x:Key="SubscribePillBorder" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="MinWidth" Value="96"/>
            </Style>

            <Style x:Key="SubscribePillButton" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TouchNavStack" TargetType="StackPanel">
                <Setter Property="MinHeight" Value="48"/>
            </Style>

            <Style x:Key="ShortsSubscribePill" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="#66000000" CornerRadius="14" Margin="0,2,0,-2"/>
                                <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ShortsOverlayLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontFamily" Value="{StaticResource Roboto}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ShortsOverlayLabelShadow" TargetType="TextBlock" BasedOn="{StaticResource ShortsOverlayLabel}">
                <Setter Property="Foreground" Value="#66000000"/>
                <Setter Property="Margin" Value="0,1,0,-1"/>
            </Style>

            <Style x:Key="ShortsOverlayTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RobotoSemiBold}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>

            <Style x:Key="ShortsOverlayTitleShadow" TargetType="TextBlock" BasedOn="{StaticResource ShortsOverlayTitle}">
                <Setter Property="Foreground" Value="#66000000"/>
                <Setter Property="Margin" Value="0,1,0,-1"/>
            </Style>

            <Style x:Key="WatchPillBorder" TargetType="Border">
                <Setter Property="Background" Value="#3A3A3A"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="MinHeight" Value="36"/>
            </Style>

            <Style x:Key="WatchActionPill" TargetType="Border" BasedOn="{StaticResource WatchPillBorder}">
                <Setter Property="Width" Value="56"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <DataTemplate x:Key="ChannelCompactVideoTemplate">
                <Grid Margin="12,4" MinHeight="72" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="10" Background="#1A1A1A" Height="68">
                        <Grid>
                            <Image Source="{Binding Thumbnail, Converter={StaticResource ThumbImageSmall}}" Stretch="UniformToFill"/>
                            <Border Background="#CC000000" Padding="4,1" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                    Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LengthText}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" TextWrapping="Wrap" MaxHeight="40" LineHeight="18"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource YtSecondary}" FontSize="12" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="VideoCardTemplate">
                <Grid x:Name="CardRoot" Margin="0,0,0,12" Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="Black" HorizontalAlignment="Stretch"
                          Height="{Binding ActualWidth, ElementName=CardRoot, Converter={StaticResource ThumbHeight916}}">
                        <Image Source="{Binding Thumbnail, Converter={StaticResource ThumbImage}}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Border Background="#CC000000" Padding="5,1" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LengthText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{StaticResource YtRed}" Padding="6,2" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="LIVE" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#CC000000" Padding="4,2" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Visibility="{Binding IsAd, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Ad" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="12,10,12,0" Visibility="{Binding IsAd, Converter={StaticResource BoolToVisInvert}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="36" Height="36" VerticalAlignment="Top" Margin="0,2,12,0">
                            <Ellipse Fill="#22FFFFFF"/>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AuthorThumbnail, Converter={StaticResource AvatarImage}}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" TextWrapping="Wrap" MaxHeight="42" LineHeight="21"/>
                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource YtSecondary}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="12,10,12,0" Visibility="{Binding IsAd, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" TextWrapping="Wrap" MaxHeight="42" LineHeight="21"/>
                        <TextBlock Text="{Binding Author}" Foreground="{StaticResource YtSecondary}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ShortCardTemplate">
                <Grid Height="{Binding CardHeight}" Margin="0,0,0,8" Background="Black">
                    <Image Source="{Binding Thumbnail, Converter={StaticResource ThumbImage}}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <Border VerticalAlignment="Bottom">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#CC000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="16,48,16,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="SHORTS" Foreground="White" FontSize="12" FontWeight="Bold" Opacity="0.9"/>
                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="52" Margin="0,6,12,0"/>
                                <TextBlock Text="{Binding Author}" Foreground="White" FontSize="14" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding ViewCountText}" Foreground="#DDFFFFFF" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Image Source="ms-appx:///youtubeicons/play.png" Width="28" Height="28" HorizontalAlignment="Center"/>
                                <TextBlock Text="Play" Foreground="White" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                                <Image Source="ms-appx:///youtubeicons/likehollow.png" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ViewCountText}" Foreground="White" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CommentTemplate">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,10,0">
                        <Ellipse Fill="#22FFFFFF"/>
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AuthorThumbnail, Converter={StaticResource AvatarImage}}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Author}" Foreground="{StaticResource YtSecondary}" FontSize="12"/>
                            <TextBlock Text="{Binding PublishedText}" Foreground="{StaticResource YtMuted}" FontSize="12" Margin="8,0,0,0"/>
                            <Border Background="#22FFFFFF" CornerRadius="2" Padding="4,0" Margin="8,0,0,0" Visibility="{Binding BadgeText, Converter={StaticResource StringToVis}}">
                                <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="10"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Content}" Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Image Source="ms-appx:///youtubeicons/likehollow.png" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LikeText}" Foreground="{StaticResource YtSecondary}" FontSize="12" Margin="6,0,16,0"/>
                            <TextBlock Text="{Binding ReplyText}" Foreground="{StaticResource YtLike}" FontSize="12" Visibility="{Binding ReplyText, Converter={StaticResource StringToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ChannelCarouselVideoTemplate">
                <Grid Width="168" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="10" Background="#1A1A1A">
                        <Grid Height="94">
                            <Image Source="{Binding Thumbnail, Converter={StaticResource ThumbImage}}" Stretch="UniformToFill"/>
                            <Border Background="#CC000000" Padding="5,1" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                    Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LengthText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="White" FontSize="13" TextWrapping="Wrap" MaxHeight="38" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" Text="{Binding Subtitle}" Foreground="{StaticResource YtSecondary}" FontSize="11" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ChannelShortCarouselTemplate">
                <Grid Width="120" Height="200" Margin="0,0,10,0">
                    <Border CornerRadius="10" Background="#1A1A1A">
                        <Grid>
                            <Image Source="{Binding Thumbnail, Converter={StaticResource ThumbImage}}" Stretch="UniformToFill"/>
                            <Border VerticalAlignment="Bottom" Background="#99000000" Padding="6">
                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11" TextWrapping="Wrap" MaxHeight="32"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="FeedVideoCardTemplate">
                <ContentControl Content="{Binding Video}" ContentTemplate="{StaticResource VideoCardTemplate}"/>
            </DataTemplate>

            <DataTemplate x:Key="FeedPlaceholderTemplate">
                <Grid Margin="0,0,0,12" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <controls:ShimmerPlaceholder Grid.Row="0" Height="202" HorizontalAlignment="Stretch"/>
                    <Grid Grid.Row="1" Margin="12,10,12,0">
                        <controls:ShimmerPlaceholder Height="14" Width="220" Margin="48,2,0,0" HorizontalAlignment="Left"/>
                        <controls:ShimmerPlaceholder Height="12" Width="160" Margin="48,28,0,0" HorizontalAlignment="Left"/>
                    </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ShortsShelfTemplate">
                <StackPanel Margin="0,0,0,12">
                    <Grid Margin="12,8,12,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="ms-appx:///youtubeicons/shortsfilled.png" Width="22" Height="22"/>
                            <TextBlock Text="Shorts" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{Binding Shorts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="120" Height="210" CornerRadius="12" Background="#1A1A1A" Margin="0,0,8,0">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail, Converter={StaticResource ThumbImage}}" Stretch="UniformToFill"/>
                                            <Border VerticalAlignment="Bottom" Background="#99000000" Padding="8,6">
                                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11" TextWrapping="Wrap" MaxHeight="40" LineHeight="14"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="CommunityPostTemplate">
                <Border Background="#1A1A1A" CornerRadius="12" Margin="0,0,0,12" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="36" Height="36" Margin="0,0,10,0">
                                <Ellipse Fill="#22FFFFFF"/>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding CommunityPost.AuthorThumbnail, Converter={StaticResource AvatarImage}}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CommunityPost.Author}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CommunityPost.PublishedText}" Foreground="{StaticResource YtSecondary}" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding CommunityPost.Content}" Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding CommunityPost.Content, Converter={StaticResource StringToVis}}"/>
                        <Border CornerRadius="10" Background="#111111" MaxHeight="280" Visibility="{Binding CommunityPost.ImageUrl, Converter={StaticResource StringToVis}}">
                            <Image Source="{Binding CommunityPost.ImageUrl, Converter={StaticResource ThumbImage}}" Stretch="Uniform" MaxHeight="280"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Image Source="ms-appx:///youtubeicons/likehollow.png" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CommunityPost.LikeText}" Foreground="{StaticResource YtSecondary}" FontSize="12" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <helpers:FeedItemTemplateSelector x:Key="FeedItemTemplateSelector"
                VideoTemplate="{StaticResource FeedVideoCardTemplate}"
                PlaceholderTemplate="{StaticResource FeedPlaceholderTemplate}"
                ShortsShelfTemplate="{StaticResource ShortsShelfTemplate}"
                CommunityPostTemplate="{StaticResource CommunityPostTemplate}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

